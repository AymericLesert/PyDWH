<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>92a0a3c8-44e8-4439-be1a-7ba55a6b533e</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>
    </StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>PyDWH</Name>
    <RootNamespace>PyDWH</RootNamespace>
    <InterpreterId>MSBuild|env|$(MSBuildProjectFullPath)</InterpreterId>
    <SuppressPackageInstallationPrompt>True</SuppressPackageInstallationPrompt>
    <IsWindowsApplication>False</IsWindowsApplication>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\configuration\configuration.py" />
    <Compile Include="src\configuration\configurationitem.py" />
    <Compile Include="src\configuration\__init__.py" />
    <Compile Include="src\exception\exception.py" />
    <Compile Include="src\exception\exceptiondatabase.py" />
    <Compile Include="src\exception\exceptiondatabasenotconnected.py" />
    <Compile Include="src\exception\exceptiondatabaserequest.py" />
    <Compile Include="src\exception\exceptiondatabaseunknown.py" />
    <Compile Include="src\exception\__init__.py" />
    <Compile Include="src\loader\loader.py" />
    <Compile Include="src\loader\loadermysql.py" />
    <Compile Include="src\loader\__init__.py" />
    <Compile Include="src\logger\logger.py" />
    <Compile Include="src\logger\loggerobject.py" />
    <Compile Include="src\logger\loggertimer.py" />
    <Compile Include="src\logger\__init__.py" />
    <Compile Include="src\rules\instance.py" />
    <Compile Include="src\rules\__init__.py" />
    <Compile Include="src\scripts\dwh_key_decrypt.py" />
    <Compile Include="src\scripts\dwh_key_encrypt.py" />
    <Compile Include="src\scripts\dwh_rules.py" />
    <Compile Include="src\scripts\dwh_key_new.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="src\scripts\__init__.py" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="env\">
      <Id>env</Id>
      <Version>3.13</Version>
      <Description>env (Python 3.13 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <ItemGroup>
    <Content Include=".env" />
    <Content Include="LICENSE.txt" />
    <Content Include="PROJECT" />
    <Content Include="pyproject.toml" />
    <Content Include="README.md" />
    <Content Include="requirements.txt" />
    <Content Include="VERSION" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="src\configuration\" />
    <Folder Include="src\logger\" />
    <Folder Include="src\exception\" />
    <Folder Include="src\" />
    <Folder Include="src\loader\" />
    <Folder Include="src\rules\" />
    <Folder Include="src\scripts\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>